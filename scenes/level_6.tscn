theme_override_font_sizes/font_size = 48
text = "Děkuji, že jsi dohrál mou hru SHAPED IN Q.

Tato hra vznikla jako moje absolventská práce. Tato hra mi trvala 4 měsíce, a na začátku to nevypadalo úplně nejlépe. Proto jsem na ní začal pracovat každým dnem klidně i několik hodin. Během tvoření jsem narazil na spustu problémů a errorů, které jsem ale dokázal vyřešit. S výsledkem jsem velmi spokojen a budu na ní pracovat i nadále, tedy pokud bude čas. Doufám, že tě hra bavila alespoň natolik, jako bavila mě tvořit.

-Václav Žemla, absolvent ZŠ Sadská"
horizontal_alignment = 1
autowrap_mode = 2

[node name="text_eng" type="Label" parent="."]
offset_top = -995.05
