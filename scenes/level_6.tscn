offset_bottom = 909.95
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_shadow_color = Color(0.0992, 0.27952, 0.32, 1)
theme_override_font_sizes/font_size = 48
text = "Thank you for finishing my game SHAPED IN Q.

This game was created as my graduation project. This game took me 4 months to make, and at the beginning it didn't look very good. That's why I started working on it every day, even for a few hours. During the creation, I encountered a lot of problems and errors, which I managed to solve. I am very satisfied with the result and will continue to work on it, if I have time. I hope you enjoyed the game at least as much as I enjoyed creating it.

-Václav Žemla, graduate of ZŠ Sadská"
horizontal_alignment = 1
autowrap_mode = 2

